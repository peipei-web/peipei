    body{font-family:system-ui;max-width:900px;margin:40px auto;line-height:1.7;padding:0 16px;}
    h1,h2{margin-top:24px;}
    .card{border:1px solid #ddd;border-radius:12px;padding:16px;margin:16px 0;}
